<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_modules_title"
            android:textColor="@color/nb_subtext"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chk_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/mod_cpu" />

            <CheckBox
                android:id="@+id/chk_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_ram" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chk_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_display" />

            <CheckBox
                android:id="@+id/chk_dnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_dnd" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chk_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_power" />

            <CheckBox
                android:id="@+id/chk_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_network" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chk_tweaks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_tweaks" />

            <CheckBox
                android:id="@+id/chk_gpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_gpu" />

            <CheckBox
                android:id="@+id/chk_thermal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mod_thermal" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_dnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/opt_dnd" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_anim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_anim" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_ram_kill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_ram_kill" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_thermal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_thermal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_dpi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_dpi"
                android:inputType="number"
                android:maxLength="4" />

            <EditText
                android:id="@+id/edit_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="@string/hint_refresh"
                android:inputType="number"
                android:maxLength="3" />

            <EditText
                android:id="@+id/edit_game_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="@string/hint_game_mode"
                android:inputType="number"
                android:maxLength="1" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
