<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Language -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nb_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lang_label"
                    android:textColor="@color/nb_text"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_lang"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/lang_switch"
                    android:textColor="@color/nb_accent"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Automation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sec_automation"
            android:textColor="@color/nb_subtext"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/nb_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_auto_boost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_boost_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_auto_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_restore_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_boot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_adaptive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/adaptive_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Overlay -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sec_overlay"
            android:textColor="@color/nb_subtext"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/nb_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_ov_fps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ov_fps_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_ov_cpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ov_cpu_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_ov_ram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ov_ram_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_ov_temp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ov_temp_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_ov_ping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ov_ping_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shizuku -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sec_shizuku"
            android:textColor="@color/nb_subtext"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/nb_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/shizuku_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shizuku_missing"
                    android:textColor="@color/nb_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/shizuku_help"
                    android:textColor="@color/nb_subtext"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_shizuku"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/shizuku_connect"
                    android:textColor="@color/nb_accent"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Safety -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sec_safety"
            android:textColor="@color/nb_subtext"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/nb_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/journal_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/journal_zero"
                    android:textColor="@color/nb_text"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restore_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/nb_danger"
                    android:text="@string/restore_all"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_restore"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

                <Button
                    android:id="@+id/btn_clear_log"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/clear_log"
                    android:textColor="@color/nb_subtext" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/nb_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_title"
                    android:textColor="@color/nb_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_text"
                    android:textColor="@color/nb_subtext"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
