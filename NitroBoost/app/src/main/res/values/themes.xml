<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Nitro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nb_accent</item>
        <item name="colorOnPrimary">@color/nb_bg</item>
        <item name="colorSecondary">@color/nb_accent2</item>
        <item name="colorOnSecondary">@color/nb_bg</item>
        <item name="android:windowBackground">@color/nb_bg</item>
        <item name="android:statusBarColor">@color/nb_bg</item>
        <item name="android:navigationBarColor">@color/nb_bg</item>
        <item name="android:textColorPrimary">@color/nb_text</item>
        <item name="android:textColorSecondary">@color/nb_subtext</item>
        <item name="android:colorBackground">@color/nb_bg</item>
    </style>

    <style name="NbSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/nb_subtext</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
